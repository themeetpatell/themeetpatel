# ── Supabase (server-side only — the CMS backend) ───────────────────────────
# Required: without these every /api/articles* route fails at request time.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key           # RLS applies — published reads only
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # bypasses RLS — admin CRUD

# ── Admin auth (server-side only) ───────────────────────────────────────────
# All three are required. If any is missing, /api/admin/login answers 503
# rather than authenticating.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=your_admin_password
JWT_SECRET=random_64_char_hex_string

# ── Resend (server-side only — form notifications) ──────────────────────────
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Vercel Blob (media uploads — server-side only) ──────────────────────────
BLOB_READ_WRITE_TOKEN=your_blob_token

# ── PostHog product analytics ───────────────────────────────────────────────
# VITE_PUBLIC_* is exposed to the browser by design (project token, not a secret)
VITE_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side capture from /api/* functions (same project token)
POSTHOG_API_KEY=phc_xxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com

# ── Deprecated ──────────────────────────────────────────────────────────────
# Neon. The database layer moved to Supabase; api/_db.js is a leftover shim and
# nothing imports it any more. Unset unless you are reviving that path.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
